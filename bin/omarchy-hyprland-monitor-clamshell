#!/bin/bash

# omarchy:summary=Apply clamshell display state to Hyprland monitors (with mirror pause & workspace migration)
# omarchy:hidden=true

TOGGLES_DIR="$HOME/.local/state/omarchy/toggles/hypr"
CLAMSHELL_FLAG="$TOGGLES_DIR/internal-monitor-clamshell.lua"
MANUAL_DISABLE_FLAG="$TOGGLES_DIR/internal-monitor-disable.lua"
SCALE_STATE="$TOGGLES_DIR/internal-monitor-scale"
MONITOR_LUA="$HOME/.config/hypr/monitors.lua"
MIRROR_FLAG="$TOGGLES_DIR/internal-monitor-mirror.lua"
MIRROR_PAUSED_FLAG="$TOGGLES_DIR/internal-monitor-mirror.lua.clamshell-paused"
# Our own extra toggle: configures the external monitor as standalone (not mirrored)
# when clamshell is active. Separate from CLAMSHELL_FLAG so the system script can
# manage the eDP disable independently without overwriting our HDMI config.
HDMI_FLAG="$TOGGLES_DIR/internal-monitor-clamshell-hdmi.lua"

INTERNAL=$(omarchy-hyprland-monitor-laptop)

if [[ -n $INTERNAL && ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Refusing unsafe internal monitor name" >&2
  exit 1
fi

valid_scale() {
  [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]]
}

scales_match() {
  local left="$1"
  local right="$2"

  valid_scale "$left" && valid_scale "$right" || return 1
  awk -v left="$left" -v right="$right" 'BEGIN {
    diff = left - right
    if (diff < 0) diff = -diff
    exit(diff < 0.001 ? 0 : 1)
  }'
}

lua_identifier() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

lua_local_value() {
  local name="$1" value
  lua_identifier "$name" && [[ -f $MONITOR_LUA ]] || return 0

  value=$(sed -nE 's/^[[:space:]]*local[[:space:]]+'\"$name\"'[[:space:]]*=[[:space:]]*(\"[^\"]*\"|[^\"[:space:]]+)[[:space:]]*(--.*)?$/\1/p' "$MONITOR_LUA" | head -1)
  [[ $value == \"*\" ]] && value="${value:1:-1}"
  printf '%s\n' "$value"
}

lua_scalar() {
  local value="$1" resolved

  if [[ $value == \"*\" ]]; then
    printf '%s\n' "${value:1:-1}"
    return
  fi

  resolved=$(lua_local_value "$value")
  printf '%s\n' "${resolved:-$value}"
}

monitor_rules() {
  [[ -f $MONITOR_LUA ]] || return 0

  sed -E -e 's/--\[\[[^]]*\]\]//g' -e 's/--.*$//' "$MONITOR_LUA"
}

monitor_rule_regex() {
  printf '^[[:space:]]*hl\\.monitor\\(\\{.*output[[:space:]]*=[[:space:]]*"%s"' "$1"
}

configured_monitor_value() {
  local output="$1" key="$2" value

  value=$(monitor_rules | sed -nE '/'\"$(monitor_rule_regex "$output")\"'/s/.*[{,;[:space:]]'\"$key\"'[[:space:]]*=[[:space:]]*(\"[^\"]*\"|[^,;}[:space:]]+)[[:space:]]*([,;}].*)?$/\1/p' | head -1)
  lua_scalar "$value"
}

configured_internal_monitor_value() {
  [[ -n $INTERNAL ]] || return 0

  configured_monitor_value "$INTERNAL" "$1"
}

configured_monitor_scale() {
  local scale
  scale=$(configured_internal_monitor_value scale)
  [[ -n $scale ]] || scale=$(configured_monitor_value "" scale)
  [[ -n $scale ]] || scale=$(lua_local_value omarchy_monitor_scale)

  printf '%s\n' "$scale"
}

current_internal_scale() {
  [[ -n $INTERNAL ]] || return 0
  hyprctl monitors all -j | jq -r --arg internal "$INTERNAL" '.[] | select(.name == $internal and .disabled != true) | .scale' | head -1
}

store_internal_scale() {
  local scale="$1"
  valid_scale "$scale" || return 0

  mkdir -p "$TOGGLES_DIR"
  printf '%s\n' "$scale" >"$SCALE_STATE"
}

remember_internal_scale() {
  local scale
  scale=$(current_internal_scale)
  store_internal_scale "$scale"
}

read_monitor_scale() {
  local scale

  if (( $# )); then
    scale="$1"
  else
    scale=$(configured_monitor_scale)
  fi

  if valid_scale "$scale"; then
    echo "$scale"
    return
  fi

  if [[ -f $SCALE_STATE ]]; then
    scale=$(<"$SCALE_STATE")
    if valid_scale "$scale"; then
      echo "$scale"
      return
    fi
  fi

  echo 2
}

read_monitor_position() {
  local position
  position=$(configured_internal_monitor_value position)
  if [[ $position =~ ^[-[:alnum:]_.+]+$ ]]; then
    echo "$position"
    return
  fi

  echo auto
}

enable_internal_output() {
  [[ -n $INTERNAL ]] || return 0
  local scale="${1:-}"
  local position
  [[ -n $scale ]] || scale=$(read_monitor_scale)
  position=$(read_monitor_position)
  hyprctl eval "hl.monitor({ output = \"$INTERNAL\", mode = \"preferred\", position = \"$position\", scale = $scale })" >/dev/null 2>&1 || true
}

sync_internal_scale() {
  [[ -n $INTERNAL ]] || return 0
  local configured_scale
  local desired_scale
  local active_scale

  configured_scale=$(configured_monitor_scale)
  active_scale=$(current_internal_scale)

  if ! valid_scale "$configured_scale" && valid_scale "$active_scale"; then
    return 0
  fi

  desired_scale=$(read_monitor_scale "$configured_scale")
  scales_match "$active_scale" "$desired_scale" && return 0

  enable_internal_output "$desired_scale"
}

dpms_internal() {
  local action="$1"

  [[ -n $INTERNAL ]] || return 0
  hyprctl dispatch "hl.dsp.dpms({ action = \"$action\", monitor = \"$INTERNAL\" })" >/dev/null 2>&1 || true
}

enable_internal() {
  local changed=0

  # Clean up our HDMI standalone flag
  if [[ -f $HDMI_FLAG ]]; then
    rm -f "$HDMI_FLAG"
    changed=1
  fi

  # Remove clamshell flag if present
  if [[ -f $CLAMSHELL_FLAG ]]; then
    rm -f "$CLAMSHELL_FLAG"
    changed=1
  fi

  # Restore mirror flag if it was paused by us
  if [[ -f $MIRROR_PAUSED_FLAG ]]; then
    mv -f "$MIRROR_PAUSED_FLAG" "$MIRROR_FLAG"
    changed=1
  fi

  if (( changed )); then
    hyprctl reload >/dev/null 2>&1 || true
  fi

  [[ -f $MANUAL_DISABLE_FLAG ]] && omarchy-hyprland-monitor-external-active && return 0
  sync_internal_scale

  if (( changed )); then
    dpms_internal enable
  fi
}

disable_internal() {
  [[ -n $INTERNAL ]] || exit 0
  [[ -f $MANUAL_DISABLE_FLAG ]] && return 0

  mkdir -p "$TOGGLES_DIR"
  remember_internal_scale

  local EXTERNAL
  EXTERNAL=$(hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)
  if [[ -z $EXTERNAL || ! $EXTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
    return 0
  fi

  # Pause mirroring: rename mirror flag so HDMI-A-1 becomes a standalone display
  if [[ -f $MIRROR_FLAG ]]; then
    mv -f "$MIRROR_FLAG" "$MIRROR_PAUSED_FLAG"
  fi

  # Write our HDMI standalone config as a SEPARATE toggle file (not CLAMSHELL_FLAG).
  # Because the system clamshell script only manages CLAMSHELL_FLAG (eDP-1 disabled),
  # it cannot overwrite this file. HDMI-A-1 stays configured as standalone even
  # across sleep/wake cycles when the system script re-runs disable_internal().
  #
  # Deliberately NO scale here: toggle files load AFTER ~/.config/hypr/monitors.lua,
  # so pinning a scale would override whatever was set from the SUPER+CTRL+D monitor
  # panel or `omarchy hyprland monitor scaling`. Leaving scale unspecified lets the
  # monitors.lua rule own it.
  printf 'hl.monitor({ output = "%s", mode = "preferred", position = "0x0" })\n' \
    "$EXTERNAL" >"$HDMI_FLAG"

  # Write CLAMSHELL_FLAG to match EXACTLY what the system script would write.
  # This makes the system script's idempotency check pass on subsequent runs
  # (sleep/wake), so it won't trigger a reload that could disturb workspaces.
  local edp_config
  edp_config=$(printf 'hl.monitor({ output = "%s", disabled = true })' "$INTERNAL")
  printf '%s\n' "$edp_config" >"$CLAMSHELL_FLAG"

  # Reload: Hyprland auto-migrates all workspaces from the disabled eDP-1
  # to HDMI-A-1 (the only remaining active monitor). No manual migration needed.
  hyprctl reload >/dev/null 2>&1 || true
}

# Only run recover calls when lid is OPEN.
# When the lid is closed, skipping the recover calls prevents the system's
# internal-mirror recover from wiping our MIRROR_PAUSED_FLAG during sleep/wake.
if ! omarchy-hw-laptop-closed; then
  # If external monitor was unplugged while mirror was paused, clean up paused state
  if [[ -f $MIRROR_PAUSED_FLAG ]] && ! omarchy-hw-external-monitors; then
    rm -f "$MIRROR_PAUSED_FLAG"
    rm -f "$HDMI_FLAG"
  fi

  omarchy-hyprland-monitor-internal recover >/dev/null 2>&1 || true
  omarchy-hyprland-monitor-internal-mirror recover >/dev/null 2>&1 || true
fi

case "$1" in
  disable)
    disable_internal
    exit 0
    ;;
  enable)
    enable_internal
    exit 0
    ;;
esac

if omarchy-hw-clamshell && omarchy-hyprland-monitor-external-active; then
  disable_internal
else
  enable_internal
fi
